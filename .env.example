PORT=3000
APP_MODE=demo
ENABLE_WEB_TERMINAL=false
ALLOW_PRIVATE_NETWORK_TARGETS=false
DATA_DIR=data
PRIVATE_DIR=private
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Web terminal rollout (disabled by default; requires APP_MODE=local and a canonical HTTP(S) origin)
# APP_MODE=local
# ENABLE_WEB_TERMINAL=true
# DASHBOARD_PUBLIC_ORIGIN=https://dashboard.example.test  # Required when terminal is enabled; exact origin, no path/query/fragment/credentials/trailing slash
# DASHBOARD_SESSION_SECRET=         # Required. Pepper for session token hashing. Minimum 32 characters in local mode.
# DASHBOARD_COOKIE_SECURE=true                         # Required for HTTPS/WSS terminal staging
# TERMINAL_GLOBAL_LIMIT=10
# TERMINAL_DASHBOARD_LIMIT=3
# TERMINAL_VPS_LIMIT=2
# TERMINAL_PENDING_LIMIT=10
# TERMINAL_OPEN_TIMEOUT_MS=10000
# TERMINAL_IDLE_TIMEOUT_MS=900000
# TERMINAL_LIFETIME_MS=7200000
# TERMINAL_REVOCATION_POLL_MS=5000
# TERMINAL_HEARTBEAT_MS=30000
# TERMINAL_OUTPUT_BUFFER_BYTES=1048576
# TERMINAL_INPUT_BUFFER_BYTES=65536
# TERMINAL_SLOW_CONSUMER_TIMEOUT_MS=10000

# Dashboard auth (required when APP_MODE=local)
# DASHBOARD_SESSION_TTL_SECONDS=86400  # Session TTL in seconds (default: 24h)
# DASHBOARD_PUBLIC_ORIGIN=          # Optional generally; required when ENABLE_WEB_TERMINAL=true. Use the exact canonical HTTP(S) origin (scheme + host[:port], no path/query/fragment/credentials/trailing slash).
# DASHBOARD_COOKIE_SECURE=false     # Set true for HTTPS/WSS terminal staging; required when SAME_SITE=none or the public origin is https:// in local mode.
# DASHBOARD_COOKIE_SAME_SITE=lax    # lax | strict | none. none requires Secure=true.
#
# Reverse proxy trust
# TRUST_PROXY_HOPS=0                # Set to 1 when behind an HTTPS reverse proxy
#
# Database (PostgreSQL)
# STORAGE_DRIVER=postgres          # json (default) | postgres
# DATABASE_URL=postgres://vps_manager:password@host:5432/vps_manager  # Required when STORAGE_DRIVER=postgres
# DB_SSL=false                     # Set true to connect with TLS (rejectUnauthorized=false)
# DB_POOL_MAX=10                   # Max pool connections
# POSTGRES_PASSWORD=               # Set by compose; used by Postgres container + DATABASE_URL

# Rate limiting (in-memory per process for JSON/demo; Postgres-backed for shared DB mode)
# RATE_LIMIT_WINDOW_MS=60000       # Mutation rate-limit window in ms (default: 60000)
# RATE_LIMIT_MAX=120               # Max mutation requests per window per IP (default: 120)
# DOCKER_ALERT_ACK_RATE_LIMIT_WINDOW_MS=60000 # Docker alert acknowledgement window (default: 60s)
# DOCKER_ALERT_ACK_RATE_LIMIT_MAX=30          # Max acknowledgements per session/VPS per window

# Local agent (in-process metrics collector, APP_MODE=local only)
# LOCAL_AGENT_ENABLED=true         # Set to false to disable local agent auto-collection (default: true in local mode)
# Local host agent upgrades use the bundled agent binary packaged in the API container (/app/agent/vps-agent-linux-amd64).
# No manual release signing keys or external catalog variables are required for local updates.
# AGENT_BINARY_PATH=                  # Optional path to Linux agent binary (defaults to /app/agent/vps-agent-linux-amd64)
#
# Local agent credential rotation helper (container client invoking host Unix domain socket)
# LOCAL_AGENT_ROTATION_HELPER=/usr/local/bin/local-agent-rotation-client
# LOCAL_AGENT_ROTATION_SOCKET=/var/run/flexserver/agent-rotation/agent-rotation.sock
# Legacy external agent release catalog (optional; unneeded for bundled updates; both must be set together if used):
# AGENT_RELEASE_PUBLIC_KEY=        # Pinned Ed25519 public key: base64 of exactly 32 raw bytes
# AGENT_RELEASE_MANIFEST_URL=      # https stable-channel pointer URL on github.com / objects.githubusercontent.com / release-assets.githubusercontent.com
# AGENT_RELEASE_TTL_SECONDS=300    # Verified manifest cache TTL in seconds (1..86400)
#
# Retention / pagination
# JOB_HISTORY_LIMIT=1000           # Max jobs kept in JSON storage (default: 1000)
# AUDIT_HISTORY_LIMIT=5000         # Max audit events kept in JSON storage (default: 5000)
# METRIC_WINDOW_LIMIT=120          # Max metric samples per VPS window (default: 120, max: 1000)
# DOCKER_MAINTENANCE_INTERVAL_SECONDS=21600 # Maintenance cadence (default: 6h, bounds: 5m..24h)
# DOCKER_ROLLUP_RETENTION_DAYS=30       # Closed hourly rollup retention (bounds: 1..365d)
# DOCKER_RESOLVED_ALERT_RETENTION_DAYS=30 # Resolved alert retention; open alerts are never pruned (bounds: 1..365d)

# SSH security
# SSH_HOST_KEY_PINS='{"vps-id-1":"SHA256:abc123...","host:port":"SHA256:xyz789..."}'  # JSON object keyed by vpsId or host:port
# SSH_HOST_KEY_POLICY=strict        # strict | permissive (default: strict)
#
# SSH private key envelope encryption (AES-256-GCM)
# Explicit external path to KEK keyring secret file.
# MUST be located outside DATA_DIR, PRIVATE_DIR, and the application project directory.
# Run `npm run manage-ssh-keys -- init --path /path/to/keyring.json` to generate.
# Default path: /etc/flexserver/ssh-keyring.json (Linux) or %ProgramData%\flexserver\ssh-keyring.json (Windows).
# SSH_KEY_ENCRYPTION_KEY_FILE=/etc/flexserver/ssh-keyring.json

# Compose applications use a separate external keyring, never the SSH key store.
# Keep key material outside DATA_DIR, PRIVATE_DIR, and the application project.
# Back up ciphertext storage and this keyring separately; keep old KEKs until
# all retained revisions, previews, secrets and registry credentials are rewrapped.
# COMPOSE_KEYRING_FILE=/etc/flexserver/compose-keyring.json
#
# The three Compose tunables below are parsed by config but not applied yet;
# behavior stays fixed (10 min claim lease, 512 KiB inventory cap, 5 min
# preview TTL). Documented as reserved — do not set them expecting effect.
# COMPOSE_CLAIM_LEASE_SECONDS=120
# COMPOSE_INVENTORY_MAX_BYTES=524288
# COMPOSE_PREVIEW_TTL_SECONDS=300
# AI settings are available by default in local mode. Connect a provider to
# inspect metrics/inventory; managed changes require approval. Set false to disable.
# APP_AI_ENABLED=true
# AI_KEYRING_FILE=/etc/flexserver/ai-keyring.json
# Assistant context defaults: 128000 window, 20000 output/headroom reserve,
# 20000 recent-tail target, and 1000000 cumulative tokens per task.
# APP_AI_CONTEXT_WINDOW_TOKENS=128000
# APP_AI_CONTEXT_MODEL_WINDOWS={"small-model":64000}
# APP_AI_CONTEXT_RESERVE_TOKENS=20000
# APP_AI_CONTEXT_TAIL_TOKENS=20000
# APP_AI_MAX_CUMULATIVE_TASK_TOKENS=1000000
# Codex OAuth provider (ChatGPT subscription quota). Public registration
# data; override only for OpenAI-side changes or offline test stubs.
# Using ChatGPT quota via non-official clients violates OpenAI ToS.
# APP_AI_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# APP_AI_CODEX_AUTH_BASE_URL=https://auth.openai.com
# APP_AI_CODEX_API_BASE_URL=https://chatgpt.com
# APP_AI_CODEX_CLI_VERSION=0.55.0
# AI keyring must be external to the project, DATA_DIR and PRIVATE_DIR.
# Supported deployment bootstraps provision it; manual installs: npm run manage-ai-keys -- init
# Never use DASHBOARD_SESSION_SECRET as an encryption key.
# Host execution additionally requires the separately installed Linux AI runtime;
# enabling this flag does not install it or grant shell/file/service permissions.
#
#
# The dashboard admin password is set via the CLI, not in env.
# For CI/CD, set GitHub Secret DASHBOARD_ADMIN_PASSWORD to auto-bootstrap on deploy.

# Signed fleet updates: external Ed25519 public PEM, never a private signing key.
# Mount the public key at the same absolute path read-only in the API container.
# Both values are required for enrollment and automatic signed release discovery.
# FLEET_RELEASE_PUBLIC_KEY_FILE=/etc/flexserver/fleet-release.pub
# FLEET_RELEASE_MANIFEST_URL=https://github.com/OWNER/REPO/releases/download/agent-stable/stable.json
# CI promotion uses environment agent-stable with required reviewers, secret
# FLEET_RELEASE_SIGNING_KEY (private PEM), FLEET_ENVIRONMENT_READ_TOKEN (environment
# metadata read permission), and variable FLEET_RELEASE_KEY_ID. Never set these in API env.
