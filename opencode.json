{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "motion": {
      "type": "remote",
      "url": "https://mcp.motion.dev",
      "enabled": true
    },
    "motion-plus": {
      "type": "remote",
      "url": "https://mcp.motion.dev/plus",
      "enabled": true
    }
  },
  "agent": {
    "designer": {
      "permission": {
        "skill": {
          "banner-design": "allow",
          "brand": "allow",
          "design": "allow",
          "design-system": "allow",
          "slides": "allow",
          "ui-styling": "allow",
          "ui-ux-pro-max": "allow"
        }
      }
    }
  }
}
