{
  "name": "vps-manager-nodejs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @vps-manager/api",
    "dev:web": "npm run dev -w @vps-manager/web",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build -w @vps-manager/web",
    "build:api": "npm run build -w @vps-manager/api",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w @vps-manager/api && npm run typecheck -w @vps-manager/web",
    "build:agent": "node scripts/agent/build-agent.mjs",
    "test:agent": "cd packages/agent && go test ./...",
    "create-agent-token": "tsx scripts/agent/create-agent-token.ts",
    "import-vps-env": "node scripts/vps/import-vps-env.mjs",
    "add-vps-env": "node scripts/vps/add-vps-from-env.mjs",
    "install-agent-env": "tsx scripts/agent/install-agent-from-env.ts",
    "set-dashboard-password": "tsx scripts/admin/set-dashboard-password.ts",
    "set-dashboard-password:prod": "node dist/scripts/set-dashboard-password.js",
    "manage-ssh-keys": "tsx scripts/admin/manage-ssh-keys.ts",
    "manage-ssh-keys:prod": "node dist/scripts/manage-ssh-keys.js",
    "revoke-agent-credentials": "tsx packages/api/src/scripts/revoke-agent-credentials.ts",
    "migrate:db": "tsx packages/api/src/db/migrate.ts"
  },
  "overrides": {
    "multer": "2.2.0",
    "proxy-addr": "2.0.8"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "nanoid": "^5.0.9",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serve-static": "^1.16.3",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.4",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.21.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.11.0",
    "supertest": "^7.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
